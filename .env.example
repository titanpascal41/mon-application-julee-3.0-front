# ==========================================
# VARIABLES D'ENVIRONNEMENT - FRONTEND
# ==========================================
# Copiez ce fichier en .env et adaptez les valeurs

# Port du serveur de développement
PORT=3002

# URL de l'API backend
REACT_APP_API_URL=http://localhost:3001

# Authentification admin
REACT_APP_ADMIN_EMAIL=admin@julee.local
REACT_APP_ADMIN_PASSWORD=JuleeAdmin@2024!

# Environnement React
REACT_APP_ENV=development

# Fuseau horaire
REACT_APP_TIMEZONE=Europe/Paris

# Langue par défaut
REACT_APP_LANGUAGE=fr
